# Copy this file to .env.local and fill in your API keys.
# These are NEVER committed – .env.local is gitignored.

# ─── FastSaverAPI ─────────────────────────────────────────────────────────────
# Obtain at: https://fastsaverapi.com  (or via RapidAPI)
FASTSAVER_API_KEY=
BOT_USERNAME=@
# ─── AIOAPI ───────────────────────────────────────────────────────────────────
# Obtain at: https://rapidapi.com/search/aioapi  (RapidAPI key)
AIOAPI_KEY=
